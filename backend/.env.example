NODE_ENV=development
PORT=4000

LOG_LEVEL=info
LOG_PRETTY=true

TRUST_PROXY=0
ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bookleaf
DATABASE_POOL_SIZE=10
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bookleaf_test

RUN_WORKER_IN_PROCESS=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
